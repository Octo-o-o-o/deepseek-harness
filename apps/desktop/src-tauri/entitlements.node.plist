<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- These exemptions weaken the hardened runtime and are granted to the
       embedded Node executable alone, never to the application binary or to
       the helper tools the sidecar spawns.

       V8 compiles JavaScript at run time, which the hardened runtime denies
       without both an executable-memory mapping and permission to run pages it
       did not sign. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Node resolves native addons by absolute path at run time. Library
       validation admits libraries signed by Apple or by this signing team, and
       the release signs every embedded Mach-O with the team identity, so the
       shipped closure alone would not need this. It is granted because a user
       may configure a plugin whose addon comes from outside the bundle, which
       library validation would otherwise refuse at load. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
