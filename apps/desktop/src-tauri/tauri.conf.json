{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dshd",
  "version": "0.1.0",
  "identifier": "com.deepseek-ai.dsh.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek Harness Desktop",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "create": false,
        "dragDropEnabled": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "publisher": "DeepSeek",
    "copyright": "Copyright (c) 2026 DeepSeek",
    "shortDescription": "DeepSeek Harness desktop application",
    "longDescription": "A desktop application for the DeepSeek Harness agent: a bundled Node runtime and the harness Web UI, served on loopback by a local sidecar.",
    "macOS": {
      "minimumSystemVersion": "13.5"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar/dist/bin/node": "bin/node",
      "../sidecar/dist/app": "app",
      "../../../LICENSE": "LICENSE",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    }
  }
}
