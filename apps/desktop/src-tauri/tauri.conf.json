{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dshd",
  "version": "0.1.12",
  "identifier": "com.octoooo.dshd",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek Harness Desktop (Unofficial)",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "create": false,
        "dragDropEnabled": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://dshd-dl.octoooo.com/updates/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3ODMxOTdGMzQ2RDUzNzAKUldSd1UyMDBmeG1ENTBFNDBLTGdpQlhBN3RjcEora0xHRlhlY1pINjdVeHc0anNvbmd0N0tIZTYK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "publisher": "Octo-o-o-o",
    "copyright": "Copyright (c) 2026 DeepSeek",
    "shortDescription": "Unofficial DeepSeek Harness desktop application",
    "longDescription": "A desktop application for the DeepSeek Harness agent: a bundled Node runtime and the harness Web UI, served on loopback by a local sidecar.",
    "macOS": {
      "minimumSystemVersion": "13.5"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar/dist/bin": "bin",
      "../sidecar/dist/app": "app",
      "../../../LICENSE": "LICENSE",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../desktop.patch.yml": "desktop.patch.yml"
    }
  }
}
